# ============================================================
# YouTube Automation System — Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to git
# ============================================================

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Database (Supabase — recommended for cloud deployment) ---
# Get from: supabase.com → your project → Settings → API
# SUPABASE_URL: "Project URL" field  (https://xxxx.supabase.co)
# SUPABASE_KEY: "service_role" key   (long eyJhbGci... JWT — NOT the publishable key)
# Leave both blank to fall back to local SQLite (ok for local dev)
SUPABASE_URL=https://meqcbswfxaksgwrachjn.supabase.co
SUPABASE_KEY=your_service_role_key_here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_user_id_here

# --- YouTube API (OAuth credentials JSON path) ---
YOUTUBE_CLIENT_SECRETS_PATH=data/youtube_client_secrets.json
YOUTUBE_TOKEN_PATH=data/youtube_token.json

# --- Research APIs ---
PEXELS_API_KEY=your_pexels_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=youtube-automation-bot/1.0

# --- Channel Config ---
CHANNEL_NAME=YourChannelName
CHANNEL_NICHE=finance_and_wealth
TARGET_AUDIENCE_GEO=US
UPLOAD_DAY=tuesday
UPLOAD_HOUR_EST=13

# --- Pipeline Config ---
MAX_RETRIES=3
VIDEO_MIN_DURATION_MIN=8
VIDEO_MAX_DURATION_MIN=16
SCRIPT_MIN_WORDS=1200
SCRIPT_MAX_WORDS=2000

# --- Paths ---
TEMP_DIR=temp
OUTPUT_DIR=output
LOGS_DIR=logs
DATA_DIR=data
DB_PATH=data/analytics.db
